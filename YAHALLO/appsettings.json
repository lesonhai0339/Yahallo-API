{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kafka": {
    "Enabled": false,
    "BootstrapServers": "localhost:9092",
    "ClientId": "yahallo-api",
    "DefaultTopic": "yahallo.events",
    "Acks": "All"
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": "localhost:6379",
    "InstanceName": "Yahallo:",
    "DefaultExpirationMinutes": 30
  }
}

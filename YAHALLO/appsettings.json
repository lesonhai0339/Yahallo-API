{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "CORS": {
    "Origins": [ "https://yahallo.online", "https://www.yahallo.online" ]
  },
  "AuthCookie": {
    "Domain": ".yahallo.online",
    "Secure": true,
    "SameSite": "Lax"
  },
  "AwsS3Options": {
    "BucketName": "yahallo-service",
    "CloundFrontDomain": "cdn.yahallo.online"
  },
  "CacheSettings": {
    "MangaDetailTtlMinutes": 10,
    "HomepageTtlMinutes": 2
  }
}

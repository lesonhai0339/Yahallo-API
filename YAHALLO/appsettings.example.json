// ============================================================================
//  appsettings.example.json  —  COPY to "appsettings.json" and fill in values.
//  (The .NET JSON config provider allows // comments; this template won't be
//   loaded by the app — the filename is just for reference.)
//
//  IMPORTANT: This app reads MOST secrets from OS ENVIRONMENT VARIABLES, not
//  from this file. Only the sections below (Logging / AwsS3Options /
//  CacheSettings / AWS) are read from JSON. See the ENVIRONMENT VARIABLES
//  block at the bottom for everything else.
// ============================================================================
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Custom section bound to AwsS3Options (DependencyInjection.cs).
  // Tells YOUR code which bucket to target — does NOT configure the SDK.
  "AwsS3Options": {
    "BucketName": "yahallo-service"
  },

  // Read by the AWS SDK via configuration.GetAWSOptions() in DependencyInjection.cs.
  // Region is REQUIRED for presigned-URL signing (SigV4 endpoint). Set it
  // explicitly so the app does not depend on a local ~/.aws profile's region.
  // Find your bucket's region in the S3 console (e.g. ap-southeast-1, us-east-1).
  //
  // Do NOT put AccessKey/SecretKey here. Credentials are resolved by the SDK
  // default chain (see ENVIRONMENT VARIABLES below) so the same build works
  // locally (profile) and on a server (env vars or IAM role).
  "AWS": {
    "Region": "ap-southeast-1"
  },

  "CacheSettings": {
    "MangaDetailTtlMinutes": 10,
    "HomepageTtlMinutes": 2
  }

  // ==========================================================================
  //  ENVIRONMENT VARIABLES (NOT read from this file — set them in the OS,
  //  container env, launchSettings.json, or your host's secret manager).
  //  Each is read via Environment.GetEnvironmentVariable(...).
  // --------------------------------------------------------------------------
  //  Database / Hangfire
  //    Server                          = "Server=...;Database=...;User Id=...;Password=...;TrustServerCertificate=True"
  //
  //  AWS credentials (default SDK chain; needed wherever there is no ~/.aws profile)
  //    AWS_ACCESS_KEY_ID               = "AKIA..."
  //    AWS_SECRET_ACCESS_KEY           = "..."
  //    AWS_SESSION_TOKEN               = "..."        // only for temporary/STS creds
  //    AWS_REGION                      = "ap-southeast-1"   // alternative to "AWS:Region" above
  //
  //  Redis
  //    Redis_Connection                = "localhost:6379"
  //
  //  JWT / authentication
  //    Authentication_SecretKey        = "<long random secret>"
  //    Authentication_ValidIssuer      = "https://localhost:7181"
  //    Authentication_ValidAudience    = "https://localhost:4200"
  //
  //  Payload encryption
  //    Encrypt_Context                 = "<key material>"
  //
  //  Elasticsearch
  //    Elastic_Url                     = "https://localhost:9200"
  //    Elastic_Key                     = "<api key>"
  //    Elastic_DefaultIndex            = "manga"
  //
  //  Email (SMTP)
  //    EmailConfiguration_From         = "no-reply@yahallo.app"
  //    EmailConfiguration_Username     = "<smtp user>"
  //    EmailConfiguration_Password     = "<smtp password>"
  //    EmailConfiguration_SecretToken  = "<token>"
  // ==========================================================================
}
